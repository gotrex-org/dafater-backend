// Dafater (دفاتر) — Postgres schema
// Migrated from the single-file localStorage app. All monetary balances
// (party ledger, treasury, stock) are DERIVED from the immutable Transaction
// log + Adjustment records, exactly like the original app. Nothing is stored
// pre-aggregated.
//
// IDs: every table has an integer primary key `id` (autoincrement) plus a
// stable, unique `uid` (cuid). Foreign keys are INTEGERS that reference the
// parent's `id` (normal relational design). The API/frontend, however, speak
// only `uid`: requests carry uids, services resolve them to ids on write, and
// a global interceptor maps `id` -> `uid` (and FK ids -> related uids) on read,
// so the integer ids never leave the API.
//
// NOTE: money fields use Float for a clean first-pass scaffold. For production
// accounting, switch to `Decimal @db.Decimal(14, 2)` (or integer cents).

generator client {
  provider      = "prisma-client-js"
  // native = local dev; linux-musl-openssl-3.0.x = node:20-alpine (Docker)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- enums -----------------------------

enum PartyRole {
  CLIENT
  SUPPLIER
  AGENT // صاحب عمولة
  PERSON // صاحب عهدة (موظف أو أي شخص شايل فلوس أمانة/سلف)
  CLEARANCE // مخلّص جمركي — حساب جاري زي المورد، بيصرف على الجمارك ويتحاسب
}

// نوع خروج البضاعة — هو اللي بيحدد السلسلة بتكمل ولا لأ:
//   OURS          خروج من المخزن → ليها كشف سائق وتخليص وجمارك
//   CLIENT_OFFICE مكتب شحن → اسم المكتب بس، مفيش كشف سائق ولا تخليص
enum VehicleSource {
  OURS
  CLIENT_OFFICE
}

enum PartyType {
  INVOICE // فاتورة
  LEDGER // حساب جاري
}

enum Currency {
  EGP
  USD
}

// النشاط — كل حركة مالية تابعة لنشاط التجارة (أصناف/مخزون/مشتريات) أو نشاط الشحن
// (بنود الشحن/تكاليف العربيات/مصاريف المخزن/التخليص). SHARED = مقسّم بين الاتنين
// بنسبة (المرتبات) — النسبة متثبّتة على الحركة في `shippingPct` وقت تسجيلها.
enum Activity {
  TRADE
  SHIPPING
  SHARED
}

enum InvoiceKind {
  SALE // بيع
  PURCHASE // شراء
}

enum OrderStatus {
  NEW
  DONE
}

// ----------------------------- enums (cont.) -----------------------------

enum UserRole {
  STAFF
  CUSTOMER
}

// أنواع التذكيرات الشخصية
enum ReminderKind {
  INSTALLMENT // قسط يُدفع
  COLLECT     // نقدية تتحصّل
  PAY         // نقدية تتدفع
  APPOINTMENT // موعد
  OTHER       // شخصي / أخرى
}

enum ReminderRecurrence {
  MONTHLY // كل شهر في يوم محدّد
  ONCE    // مرة واحدة في تاريخ محدّد
}

// بنود مالية خاصة بالمالك فقط
enum OwnerEntryKind {
  PERSONAL_EXPENSE // مصروف شخصي
  COMPANY_PAYMENT  // دفعة شهرية للشركة
  CLIENT_PAYMENT   // دفعة شهرية لعميل
}

// ----------------------------- auth -----------------------------

model User {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(cuid())
  username  String?  @unique
  name      String
  pinHash   String
  admin     Boolean  @default(false)
  // The single owner account: the only user who can see the trial balance
  // (ميزان الحسابات), and whose account/password no other user can edit or delete.
  isPrimary Boolean  @default(false)
  // Allowed view/permission keys: dash, invoices, deals, orders, requests,
  // manifests, entry, inventory, ledger, treasury, settings, audit
  // Sub-keys: entry.*, invoices.*, deals.*, manifests.driverTrips,
  //           inventory.addWarehouse, inventory.loans,
  //           treasury.add, treasury.forex, settings.users, settings.general
  views          String[] @default([])
  // UIDs of parties this user can view in ledger; empty = all parties
  ledgerPartyIds String[] @default([])
  // UIDs of treasuries this user can see/transact against; empty = all treasuries
  treasuryIds    String[] @default([])
  // Incremented to revoke all outstanding JWTs (e.g. on PIN change / forced logout)
  tokenVersion   Int      @default(0)
  role         UserRole @default(STAFF)
  // آخر ظهور — بيتحدّث بنبضة كل دقيقة والتطبيق مفتوح، والدخول. يبان منه مين أونلاين وآخر فتح.
  lastSeenAt   DateTime?
  party        Party?   @relation(fields: [partyId], references: [id])
  partyId      Int?
  createdTransactions Transaction[]
  reminders           Reminder[]
  ownerEntries        OwnerEntry[]
  // تصفية الشريك المربوطة بالحساب ده — شوف Partner.userId
  partner             Partner?
  capitalMovementsAdded PartnerCapitalMovement[] @relation("CapitalMovementCreatedBy")
  partnerPaymentsAdded  PartnerPayment[]         @relation("PartnerPaymentCreatedBy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A private financial entry visible only to its owner (the primary account): personal
// expenses, and monthly payments to my company / to clients — with an optional discount.
model OwnerEntry {
  id        Int            @id @default(autoincrement())
  uid       String         @unique @default(cuid())
  kind      OwnerEntryKind
  title     String
  amount    Float          @default(0)
  discount  Float          @default(0) // خصم (من الشركات) — الصافي = amount - discount
  date      DateTime
  note      String?
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([ownerId])
}

// Personal reminders private to their owner (each user sees only their own): monthly
// bills/installments on a chosen day, cash to collect/pay, appointments, anything personal.
model Reminder {
  id         Int                @id @default(autoincrement())
  uid        String             @unique @default(cuid())
  title      String
  kind       ReminderKind       @default(OTHER)
  amount     Float              @default(0)
  recurrence ReminderRecurrence @default(MONTHLY)
  dayOfMonth Int? // 1..31 — for MONTHLY
  date       DateTime? // for ONCE
  note       String?
  // MONTHLY: "YYYY-MM" of the last month marked done. ONCE: doneAt set when done.
  doneMonth  String?
  doneAt     DateTime?
  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    Int
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([ownerId])
}

// --------------------------- master data ---------------------------

model Party {
  id      Int        @id @default(autoincrement())
  uid     String     @unique @default(cuid())
  name     String
  role     PartyRole
  type     PartyType? // only meaningful for clients
  phone    String?
  currency Currency   @default(EGP) // العملة اللي بيتعامل بيها الطرف
  opening  Float      @default(0) // opening balance (+ = owes us)
  hidden   Boolean    @default(false)
  note     String? // ملاحظات (مكاتب التخليص)

  // Marks the single system placeholder party used for "بيع مباشر" (direct sale,
  // no customer picked) — see PartiesService.getOrCreateDirectSaleParty().
  isDirectSale Boolean @default(false)

  // self-relation: link a client to a supplier so they share one ledger
  linkedPartyId Int?    @unique
  linkedParty   Party?  @relation("PartyLink", fields: [linkedPartyId], references: [id], onDelete: SetNull)
  linkedFrom    Party?  @relation("PartyLink")

  // مكتب تخليص (CLEARANCE) مربوط بمورد: التخليص والدفعات الجديدة تُرحَّل على حساب
  // المورد مباشرة، والمكتب يبقى اسماً على الحركة (Transaction.clearanceAgentId).
  clearanceSupplierId Int?
  clearanceSupplier   Party?        @relation("ClearanceSupplier", fields: [clearanceSupplierId], references: [id], onDelete: SetNull)
  clearanceOffices    Party[]       @relation("ClearanceSupplier")
  clearanceMovements  Transaction[] @relation("TxClearanceAgent")

  transactions     Transaction[]
  invoices         Invoice[]
  returns          Return[]
  discounts        Discount[]
  itemCommissions  InvoiceItem[] @relation("ItemCommission")
  dealItemCommissions DealItem[] @relation("DealItemCommission")
  discountSchedules DiscountSchedule[]
  dealsAsClient    Deal[]   @relation("DealClient")
  dealsAsSupplier  Deal[]   @relation("DealSupplier")
  requests         Request[]
  userAccounts     User[]
  orders           Order[]
  dollarTxs        DollarAgentTx[]
  driverTrips      DriverTrip[]
  loans            Loan[]
  clearedManifests Manifest[] @relation("ManifestClearingAgent")
  partnerSuppliers PartnerSupplier[]    @relation("PartnerSupplier")
  supplierPriceLists SupplierPriceList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model TreasuryAccount {
  id       Int      @id @default(autoincrement())
  uid      String   @unique @default(cuid())
  name     String
  opening  Float    @default(0)
  currency Currency @default(EGP)

  transactions      Transaction[] @relation("TxTreasury")
  transactionsAlt   Transaction[] @relation("TxTreasury2")
  invoices          Invoice[]
  deals             Deal[]
  returns           Return[]
  expenseSchedules  WarehouseExpenseSchedule[]
  itemFreightPayments InvoiceItem[] @relation("ItemFreightTreasury")
  itemTeaPayments     InvoiceItem[] @relation("ItemTeaTreasury")
  dealItemFreightPayments DealItem[] @relation("DealItemFreightTreasury")
  dealItemTeaPayments     DealItem[] @relation("DealItemTeaTreasury")
  dollarTxs         DollarAgentTx[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id   Int    @id @default(autoincrement())
  uid  String @unique @default(cuid())
  name String

  invoices    Invoice[]
  adjustments Adjustment[]
  returns     Return[]
  transactions Transaction[] @relation("TxWarehouse")
  expenseSchedules WarehouseExpenseSchedule[]
  loans       Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id   Int     @id @default(autoincrement())
  uid  String  @unique @default(cuid())
  name String
  unit String?
  service Boolean @default(false) // a charge/service line (نولون، تخليص…) — excluded from stock

  // أرشفة: يختفي من القوايم والاختيارات، وفواتيره وحركاته القديمة تفضل زي ما هي.
  // الفواتير بتشاور على الصنف بـ Restrict وعمود إجباري، فمفيش حذف حقيقي من غير ما
  // ياخد الفواتير معاه — الأرشفة هي الطريقة الوحيدة "يتشال" والتاريخ يفضل سليم.
  hidden Boolean @default(false)

  // Manually-set valuation price — when > 0, used as the warehouse-stock unit cost
  // instead of the computed weighted-average purchase price (see BalancesRepository).
  price Float @default(0)

  // سعر شراء/بيع ثابت للصنف — بيتحط تلقائيًا في سطر الفاتورة لما تختار الصنف، وقابل
  // للتعديل على الفاتورة من غير ما يتغيّر هنا. 0 = مفيش سعر ثابت (السطر يفضل فاضي).
  // مستقلّين عن `price` اللي فوق — ده سعر تقييم المخزون، ودول أسعار التعامل.
  purchasePrice Float @default(0)
  salePrice     Float @default(0)

  // Auto-appear as a blank line on every new invoice of that kind (independent of
  // `service` — a pinned line is usually also a service line, but the two are separate
  // switches: `service` controls stock exclusion, these control which invoices it shows on).
  pinSale     Boolean @default(false)
  pinPurchase Boolean @default(false)

  invoiceItems InvoiceItem[]
  priceListItems SupplierPriceListItem[]
  itemWeeks      InvoiceItemWeek[]
  returnItems  ReturnItem[]
  dealItems    DealItem[]
  adjustments  Adjustment[]
  loans        Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ExpenseGroup {
  WAREHOUSE // مصاريف مخزن
  EXTERNAL  // مصاريف خارجية
}

model ExpenseCategory {
  id   Int    @id @default(autoincrement())
  uid  String @unique @default(cuid())
  name String
  // البند تحت أي مجموعة رئيسية في تقرير المصاريف (مصاريف مخزن / مصاريف خارجية)
  group ExpenseGroup @default(WAREHOUSE)
  // true = مصروف يُضاف على تكلفة البضاعة (زي الناولون والشاي)؛ false = مصروف تشغيلي (مرتبات/إيجار)
  addsToGoods Boolean @default(false)
  // النشاط اللي المصروف بيتحسب عليه. SHARED = مقسّم بنسبة Config.salaryShippingPct.
  activity Activity @default(TRADE)
  // البند بيتربط بعربية (تحميل/شفتنة) — الصرف بيعرض خانة اختيارية للعربية.
  vehicleLink Boolean @default(false)
  // مؤرشف: البند المستخدم في حركات بيتأرشف بدل الحذف — الحركات القديمة بتفضل باسم بندها.
  hidden      Boolean @default(false)

  transactions Transaction[]
  expenseSchedules WarehouseExpenseSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// مصروف مخزن ثابت شهري (إيجار/مرتبات) — بيتخصم أوتوماتيك كل شهر من الخزنة المحدّدة
model WarehouseExpenseSchedule {
  id          Int              @id @default(autoincrement())
  uid         String           @unique @default(cuid())
  // اختياري — البند ممكن يبقى على الشركة عمومًا مش مرتبط بمخزن معيّن.
  warehouse   Warehouse?       @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouseId Int?
  treasury    TreasuryAccount? @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryId  Int?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  Int?
  title       String
  amount      Float            @default(0)
  dayOfMonth  Int              @default(1)
  active      Boolean          @default(true)
  lastApplied String? // "YYYY-MM" لآخر شهر اتولّد له استحقاق
  createdAt   DateTime         @default(now())
  dues        WarehouseExpenseDue[]

  @@index([warehouseId])
}

// استحقاق شهري لبند مخزن ثابت — بيتولّد تلقائي كل شهر لكن ما يتدفعش لحد ما يتأكّد عليه.
model WarehouseExpenseDue {
  id         Int                      @id @default(autoincrement())
  uid        String                   @unique @default(cuid())
  schedule   WarehouseExpenseSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId Int
  period     String // "YYYY-MM"
  title      String
  amount     Float                    @default(0)
  paid       Boolean                  @default(false)
  paidAt     DateTime?
  createdAt  DateTime                 @default(now())

  @@unique([scheduleId, period])
  @@index([paid])
}

// ------------------------- ledger / treasury -------------------------
// Single source of truth. Every financial movement is a Transaction.

model Transaction {
  id   Int      @id @default(autoincrement())
  uid  String   @unique @default(cuid())
  date DateTime
  type String // فاتورة بيع / تحصيل / مصروف / تحويل بين الخزائن ... (kept as label)

  party   Party?  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId Int?

  // مكتب التخليص صاحب الحركة. لما المكتب مربوط بمورد، partyId = المورد وهذا = المكتب.
  clearanceAgent   Party? @relation("TxClearanceAgent", fields: [clearanceAgentId], references: [id], onDelete: SetNull)
  clearanceAgentId Int?

  treasury   TreasuryAccount? @relation("TxTreasury", fields: [treasuryId], references: [id], onDelete: Cascade)
  treasuryId Int?

  treasury2   TreasuryAccount? @relation("TxTreasury2", fields: [treasuryId2], references: [id], onDelete: Cascade)
  treasuryId2 Int?

  category   ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId Int?

  debit    Float @default(0) // owed to us (party) / paid out
  credit   Float @default(0) // we owe (party) / received
  cashIn   Float @default(0) // into treasury
  cashOut  Float @default(0) // out of treasury
  cashIn2  Float @default(0) // into treasury2
  cashOut2 Float @default(0) // out of treasury2
  expAmt   Float @default(0) // commission/expense amount
  // EGP-per-USD rate for movements on a USD party (from the invoice or daily entry);
  // 0 when not applicable. Lets the trial balance weight each party's average rate.
  exchangeRate Float @default(0)

  // نشاط الحركة (تجارة/شحن/مشترك). بيتحدّد تلقائي عند الإنشاء — شوف common/activity.ts.
  activity    Activity @default(TRADE)
  // نصيب الشحن % للحركة المشتركة (SHARED) — متثبّت وقت التسجيل.
  shippingPct Float?

  // "تحصيل مجهول": cash received whose owner is unknown; sits pending until
  // resolved to a party, then credited to their ledger.
  pending Boolean @default(false)

  note String?

  // ملاحظة تظهر للعميل في بوابته بدل البيان الداخلي. التحصيل بيظهر للعميل
  // "استلام نقدية" من غير تفاصيل إلا لو اتكتبت هنا ملاحظة مخصوصة له.
  clientNote String?

  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId Int?

  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId Int?

  return   Return? @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId Int?

  discount   Discount? @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId Int?

  // مصروف مخزن مرتبط بمخزن معيّن (إيجار/مرتبات/تحميل/ناولون/تخليص)
  warehouse   Warehouse? @relation("TxWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouseId Int?

  // مصروف متثبّت على عربية بعينها — اتضاف من تاب العربية جوّه الفاتورة، فبيفضل فيها
  // مهما اتغيّر تاريخه (بعكس المصاريف اللي التاب بياخدها بالنافذة الزمنية).
  manifest   Manifest? @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  manifestId Int?

  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?

  // Ties together sibling rows created by ONE user action (e.g. a collection +
  // its transfer fee, a party-transfer's two legs) so deleting one deletes all.
  // No formal FK — same "raw pointer" convention as LoanReturn.txId /
  // DriverTrip.delayTxId below; see backend/src/common/transaction-cascade.ts.
  groupId String?

  createdAt DateTime @default(now())

  @@index([partyId])
  @@index([treasuryId])
  @@index([date])
  @@index([groupId])
  @@index([manifestId])
  @@index([activity])
  @@index([clearanceAgentId])
}

// ----------------------------- invoices -----------------------------

model Invoice {
  id   Int         @id @default(autoincrement())
  uid  String      @unique @default(cuid())
  kind InvoiceKind
  no   String
  date DateTime

  party   Party  @relation(fields: [partyId], references: [id], onDelete: Restrict)
  partyId Int

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId Int

  currency   Currency         @default(EGP)
  // EGP-per-USD rate captured at purchase time on a USD (dollar) invoice; null/0 for
  // EGP invoices. Used to show the EGP equivalent and to weight the party's average rate.
  exchangeRate Float?

  paid       Float            @default(0)
  // خصم على الفاتورة — يقلّل صافي المبلغ المستحق على/للطرف (الصافي = إجمالي الأصناف − الخصم)
  discount   Float            @default(0)
  // فاتورة وهمية: مستند فقط — لا تؤثّر على رصيد الطرف ولا الخزنة ولا التقارير
  fake       Boolean          @default(false)
  // مؤرشفة: بتختفي من قوايم الفواتير وتابات العميل والبوابة، وحركاتها وأرقامها
  // بتفضل زي ما هي بالظبط في كشف الحساب والتقارير — إخفاء عرض بس مش حذف.
  hidden     Boolean          @default(false)
  treasury   TreasuryAccount? @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryId Int?

  note String?

  commissionAmount Float?
  commissionTo     String?

  items        InvoiceItem[]
  // بنود الشحن (نولون/تحميل/شفتنة…) — جدول منفصل عن الأصناف، لا يؤثر على المخزون.
  charges      InvoiceCharge[]
  // تعليم الفاتورة كعربية داخلة في شراكة مازن
  // العربيات الداخلة في تصفية شريك أو أكتر — شوف PartnerVehicle
  partnerVehicles PartnerVehicle[]
  itemWeeks       InvoiceItemWeek[]
  transactions Transaction[]
  manifests    Manifest[]
  returns      Return[]
  // رحلة السواق المربوطة بالفاتورة دي (واحد لواحد) — شوف DriverTrip.invoiceId
  driverTrip   DriverTrip? @relation("TripInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([partyId])
  // الـ index ده موجود في الداتابيز من migration الأرشفة — متكتوب هنا عشان الـ schema
  // تطابق الواقع، من غيره كل migration جديدة بتحاول تشيله.
  @@index([hidden])
  // رقم فاتورة فريد لكل طرف — يمنع تكرار الرقم من تسابق nextNo (اقرأ max ثم +1).
  @@unique([partyId, no])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  uid       String  @unique @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int
  qty       Float
  price     Float
  // تكاليف إضافية على البند لحساب صافي تكلفة الصنف عليك (landed cost) — كلها تُضاف للتكلفة
  freight    Float @default(0) // ناولون (يُدفع نقدًا من خزينة مختارة)
  tea        Float @default(0) // شاي (يُدفع نقدًا من خزينة مختارة)
  // كل من الناولون/الشاي بيتدفع من خزينة يختارها المستخدم وبيان خاص بيه.
  freightTreasury   TreasuryAccount? @relation("ItemFreightTreasury", fields: [freightTreasuryId], references: [id], onDelete: SetNull)
  freightTreasuryId Int?
  freightNote       String?
  teaTreasury   TreasuryAccount? @relation("ItemTeaTreasury", fields: [teaTreasuryId], references: [id], onDelete: SetNull)
  teaTreasuryId Int?
  teaNote       String?
  commission Float @default(0) // عمولة = عدد × سعر (تترحّل لحساب صاحبها)
  commissionQty   Float @default(0) // عدد العمولة
  commissionPrice Float @default(0) // سعر وحدة العمولة
  commissionParty   Party? @relation("ItemCommission", fields: [commissionPartyId], references: [id], onDelete: SetNull)
  commissionPartyId Int?

  @@index([invoiceId])
  @@index([commissionPartyId])
  // موجودين في الداتابيز من migration خزن الناولون والشاي — مكتوبين هنا عشان
  // الـ schema تطابق الواقع (زي @@index([hidden]) في Invoice).
  @@index([freightTreasuryId])
  @@index([teaTreasuryId])
}

// بند شحن — قائمة قابلة للتعديل من الإعدادات (نولون/تحميل/شفتنة…).
model ChargeType {
  id        Int             @id @default(autoincrement())
  uid       String          @unique @default(cuid())
  name      String          @unique
  sortOrder Int             @default(0)
  // أرشفة بدل الحذف لو البند مستخدم — الفواتير القديمة بتشاور عليه.
  hidden    Boolean         @default(false)
  charges   InvoiceCharge[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// سطر بند شحن على فاتورة — الإجمالي = الكمية × السعر. نشاطه شحن دايماً.
model InvoiceCharge {
  id           Int        @id @default(autoincrement())
  uid          String     @unique @default(cuid())
  invoice      Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    Int
  chargeType   ChargeType @relation(fields: [chargeTypeId], references: [id], onDelete: Restrict)
  chargeTypeId Int
  qty          Float      @default(1)
  price        Float
  note         String?
  // العربية اللي البند ده إيرادها — اختياري. لو الفاتورة عليها عربية واحدة بس،
  // البنود غير المربوطة بتتحسب عليها تلقائي في كشف العربية.
  manifest     Manifest?  @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  manifestId   Int?

  @@index([invoiceId])
  @@index([manifestId])
}

// ------------------------------ returns ------------------------------
// A return (مرتجع) of goods from an invoice. kind mirrors the original sale/purchase:
//   SALE     = عميل رجّع بضاعة → المخزن يزيد، ويتعمل له credit (يقل اللي عليه)
//   PURCHASE = رجّعنا بضاعة للمورد → المخزن يقل، ويتعمل debit للمورد (يقل اللي له)
// Optionally refunds cash through a treasury. May be linked to the original invoice, or
// stand alone (free return where you pick the party/items manually).
model Return {
  id   Int         @id @default(autoincrement())
  uid  String      @unique @default(cuid())
  kind InvoiceKind
  no   String
  date DateTime

  party   Party @relation(fields: [partyId], references: [id], onDelete: Restrict)
  partyId Int

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId Int

  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId Int?

  // Cash refunded (SALE) / received back (PURCHASE), and the treasury it moved through.
  refund     Float            @default(0)
  treasury   TreasuryAccount? @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryId Int?

  note String?

  items        ReturnItem[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([partyId])
}

model ReturnItem {
  id        Int     @id @default(autoincrement())
  uid       String  @unique @default(cuid())
  return    Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int
  qty       Float
  price     Float

  @@index([returnId])
}

// ------------------------------ discounts ------------------------------
// An indirect discount not tied to a single invoice (e.g. a supplier's monthly rebate on
// purchases, or a discount granted to a client). It adjusts the party's ledger: a SUPPLIER
// discount reduces what we owe (debit), a CLIENT discount reduces what they owe (credit).
model Discount {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(cuid())
  date      DateTime
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Restrict)
  partyId   Int
  amount    Float    @default(0)
  note      String?
  // set when this discount was auto-generated from a recurring schedule
  schedule   DiscountSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  scheduleId Int?
  transactions Transaction[]
  createdAt DateTime @default(now())

  @@index([partyId])
  // خصم مجدوَل واحد لكل (جدول، تاريخ مناسبة) — يمنع الترحيل المزدوج لو processDue اتنفّذ
  // بالتوازي. الخصومات اليدوية (scheduleId = null) مش متأثرة لأن NULL في بوستجرس فريد دايمًا.
  @@unique([scheduleId, date])
}

enum DiscountRecurrence {
  MONTHLY   // كل شهر
  QUARTERLY // كل 3 شهور
  YEARLY    // كل سنة
}

// A recurring discount for a company (party): applied automatically on each occurrence
// (starting from startDate, then +1 period each time). Either a fixed amount, or a
// percentage of the party's net purchases during the elapsed period.
model DiscountSchedule {
  id          Int                @id @default(autoincrement())
  uid         String             @unique @default(cuid())
  party       Party              @relation(fields: [partyId], references: [id], onDelete: Restrict)
  partyId     Int
  amount      Float              @default(0) // مبلغ ثابت
  percent     Float              @default(0) // نسبة % من مشتريات الفترة (تُستخدم لو > 0)
  cartons     Float              @default(0) // عدد كراتين (تُستخدم لو > 0)
  cartonPrice Float              @default(0) // سعر الكرتونة (مع cartons)
  recurrence  DiscountRecurrence
  startDate   DateTime           // أول ميعاد ومنه يتكرّر
  note        String?
  active      Boolean            @default(true)
  lastApplied String? // مفتاح آخر مناسبة اتطبّقت (تاريخ الـ occurrence)
  discounts   Discount[]
  createdAt   DateTime           @default(now())

  @@index([partyId])
}

// ------------------------------ deals ------------------------------
// External pass-through sales (no stock impact).

model Deal {
  id   Int      @id @default(autoincrement())
  uid  String   @unique @default(cuid())
  no   String
  date DateTime

  client   Party  @relation("DealClient", fields: [clientId], references: [id], onDelete: Restrict)
  clientId Int

  supplier   Party  @relation("DealSupplier", fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId Int

  paidIn     Float            @default(0)
  paidOut    Float            @default(0)
  nawlon     Float            @default(0)
  treasury   TreasuryAccount? @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryId Int?

  note String?

  items        DealItem[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // رقم عملية فريد لكل عميل — يمنع تكرار الرقم من تسابق nextNo.
  @@unique([clientId, no])
}

model DealItem {
  id        Int     @id @default(autoincrement())
  uid       String  @unique @default(cuid())
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId Int
  qty       Float
  price     Float // sell price (to client)
  buyPrice  Float @default(0) // buy price (from supplier)
  // تكاليف إضافية على البند — زي الفواتير بالظبط (بس ناولونه "ناولون خارجي")
  freight    Float @default(0) // ناولون خارجي (يُدفع من خزينة مختارة)
  tea        Float @default(0) // شاي
  freightTreasury   TreasuryAccount? @relation("DealItemFreightTreasury", fields: [freightTreasuryId], references: [id], onDelete: SetNull)
  freightTreasuryId Int?
  freightNote       String?
  teaTreasury   TreasuryAccount? @relation("DealItemTeaTreasury", fields: [teaTreasuryId], references: [id], onDelete: SetNull)
  teaTreasuryId Int?
  teaNote       String?
  commission Float @default(0)
  commissionQty   Float @default(0)
  commissionPrice Float @default(0)
  commissionParty   Party? @relation("DealItemCommission", fields: [commissionPartyId], references: [id], onDelete: SetNull)
  commissionPartyId Int?

  @@index([dealId])
  @@index([commissionPartyId])
}

// -------------------------- stock adjustments --------------------------

model Adjustment {
  id          Int       @id @default(autoincrement())
  uid         String    @unique @default(cuid())
  date        DateTime
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   Int
  qty         Float // net change (+/-)
  note        String?

  createdAt DateTime @default(now())

  @@index([warehouseId])
  @@index([productId])
}

// ------------------------------ requests ------------------------------

model Request {
  id       Int      @id @default(autoincrement())
  uid      String   @unique @default(cuid())
  date     DateTime
  client   Party    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int
  note     String?
  done     Boolean  @default(false)
  doneDate DateTime?

  items RequestItem[]

  createdAt DateTime @default(now())

  @@index([clientId])
}

model RequestItem {
  id        Int     @id @default(autoincrement())
  uid       String  @unique @default(cuid())
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId Int
  name      String // free text (not linked to Product)
  qty       Float // ordered quantity
  received  Float   @default(0) // delivered so far; remaining = qty - received
}

// ------------------------------ manifests ------------------------------

model Manifest {
  id          Int      @id @default(autoincrement())
  uid         String   @unique @default(cuid())
  no          String
  date        DateTime
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId   Int?
  clientName  String
  vehicleNo   String?
  // مسمّى العربية (عربية الزيتون / عربية ديدي) — اسم متعارف عليه غير رقم اللوحة واسم السائق
  vehicleLabel String?
  trailerNo   String?
  driverName  String?
  driverPhone String?
  driverNID   String?
  // اسم المخلّص القديم كنص حر — متسيب للداتا القديمة. الربط الحقيقي بقى
  // clearingAgentId على طرف بدور CLEARANCE عشان يبقى ليه حساب جاري.
  clearingAgent String?
  clearingAgentParty Party? @relation("ManifestClearingAgent", fields: [clearingAgentId], references: [id], onDelete: SetNull)
  clearingAgentId    Int?
  note        String?

  // نوع الخروج. الافتراضي OURS (خروج من المخزن) عشان كل الكشوفات القديمة تفضل
  // زي ما هي. شوف enum VehicleSource فوق.
  vehicleSource  VehicleSource @default(OURS)
  // اسم مكتب الشحن لما يكون الخروج من مكتب شحن — اسم بس، مش طرف له حساب.
  shippingOffice String?

  // قفل تاب العربية جوّه الفاتورة: بعد القفل التاب ما بيشيلش مصاريف جديدة بالتاريخ،
  // والمصاريف اللي بعد كده بتروح للعربية اللي بعدها. مين قفل واتقفل امتى للسجل.
  closedAt DateTime?
  closedBy String?

  items        ManifestItem[]
  driverTrips  DriverTrip[]
  transactions Transaction[]
  charges      InvoiceCharge[]

  @@index([clearingAgentId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ManifestItem {
  id         Int      @id @default(autoincrement())
  uid        String   @unique @default(cuid())
  manifest   Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  manifestId Int
  name       String
  qty        Float
}

// -------------------------- driver trips --------------------------

model Driver {
  id         Int      @id @default(autoincrement())
  uid        String   @unique @default(cuid())
  name       String   @unique
  nationalId String?
  phone      String?
  phone2     String?
  vehicleNo  String?
  // مسمّى العربية — بيتعبّى تلقائيًا في الكشف والرحلة لما السائق يتختار
  vehicleLabel String?
  trailerNo  String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DriverTrip {
  id            Int       @id @default(autoincrement())
  uid           String    @unique @default(cuid())

  manifest      Manifest? @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  manifestId    Int?

  party         Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyId       Int?

  // الفاتورة اللي الناولون اتحصّل فيها من العميل. رحلة واحدة = فاتورة واحدة، فالعمود
  // unique. اللي بيتدفع للسواق هنا (`agreedFreight`) واللي بيتحصّل من العميل بند
  // «ناولون» على الفاتورة دي — الفرق بينهم مكسب النقلة. الربط صريح عشان سلسلة
  // (رحلة ← كشف عربية ← فاتورة) مش مليانة في الداتا القديمة.
  invoice       Invoice?  @relation("TripInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId     Int?      @unique

  driverName    String
  vehicleNo     String?
  // مسمّى العربية — بيظهر في بيان «عطلة عربية» على كشف حساب العميل
  vehicleLabel  String?
  trailerNo     String?
  clientName    String

  departureDate DateTime
  agreedFreight Float                    // الناولون المتفق عليه
  note          String?

  arrivalDate      DateTime?              // set when trip ends
  delayTxId        Int?                   // transaction id for posted delay fee
  delayFee         Float     @default(0)  // computed delay fee (1200/day after day 8)
  weightDiffAmount Float     @default(0)  // فرق وزن charged to client at arrival
  weightDiffTxId   Int?                   // transaction id for the weight-diff party debit

  payments      DriverPayment[]

  createdAt     DateTime  @default(now())

  @@index([manifestId])
  @@index([partyId])
  @@map("driver_trips")
}

model DriverPayment {
  id        Int        @id @default(autoincrement())
  uid       String     @unique @default(cuid())
  trip      DriverTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    Int
  date        DateTime
  amount      Float
  paymentType String   @default("freight")  // freight | delay
  note        String?
  // id of the paired treasury Transaction created alongside this payment, if any
  // (raw pointer, same convention as LoanReturn.txId) — see transaction-cascade.ts.
  txId        Int?
  createdAt   DateTime @default(now())

  @@index([tripId])
  @@map("driver_payments")
}

// سلفة على مستوى السائق (مستقلة عن الرحلة) — كاش يخرج من خزنة، وبتتسدّد من العطلات المكتسبة
model DriverAdvance {
  id         Int      @id @default(autoincrement())
  uid        String   @unique @default(cuid())
  driverName String
  date       DateTime
  amount     Float
  note       String?
  // حركة الخزينة المدفوعة مع السلفة (cashOut) — نفس أسلوب DriverPayment.txId
  txId       Int?
  createdAt  DateTime @default(now())

  @@index([driverName])
  @@map("driver_advances")
}

// -------------------------- public orders --------------------------

model Order {
  id     Int         @id @default(autoincrement())
  uid    String      @unique @default(cuid())
  date   DateTime    @default(now())
  name   String
  phone  String?
  note   String?
  status OrderStatus @default(NEW)

  items OrderItem[]

  party   Party? @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyId Int?

  createdAt DateTime @default(now())
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  uid      String @unique @default(cuid())
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId  Int
  name     String
  qty      Float
  received Float  @default(0)
}

// ------------------------------ config ------------------------------

model Config {
  id             Int    @id @default(1) // singleton row
  orderEmail     String @default("yusuftarek.97@gmail.com")
  delayGraceDays Int    @default(8)    // أيام الحرية قبل بداية العطلة
  delayFeePerDay Float  @default(1200) // قيمة يوم العطلة بالجنيه
  // نصيب نشاط الشحن % من المصاريف المشتركة (المرتبات) — والباقي تجارة.
  salaryShippingPct Float @default(50)
}

// ------------------------------ audit log ------------------------------
// One row per mutating request (who did what, and when).

model AuditLog {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(cuid())
  userName  String
  action    String   // CREATE | UPDATE | DELETE
  entity    String   // invoices, manifests, parties, ...
  entityUid String?  // uid of the affected record (for deep-link / undo)
  summary   String?  // friendly label (e.g. invoice no / party name)
  diff      Json?    // per-field { from, to } map — UPDATE only
  snapshot  Json?    // full entity state captured before DELETE (used for undo)
  // مراجعة المدير لتعديلات باقي المستخدمين: PENDING | APPROVED | REJECTED.
  // null = لا يحتاج مراجعة (إضافة/حذف، أو تعديل من المدير، أو سجل قديم).
  reviewStatus String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([reviewStatus])
}

// ------------------------------ borrowed goods (العارية) ------------------------------

model Loan {
  id              Int       @id @default(autoincrement())
  uid             String    @unique @default(cuid())
  date            DateTime
  borrowerName    String?
  partyId         Int?
  party           Party?    @relation(fields: [partyId], references: [id])
  qty             Float
  note            String?
  status          String    @default("OPEN")  // OPEN | RETURNED
  returnType      String?                      // GOODS | CASH | DEBT | MIXED
  returnedQty     Float     @default(0)        // cumulative GOODS returned
  cashReturnedQty Float     @default(0)        // cumulative CASH/DEBT qty
  returnDate      DateTime?
  returnNote      String?
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId       Int
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  warehouseId     Int
  returns         LoanReturn[]
  createdAt       DateTime  @default(now())

  @@index([warehouseId])
  @@index([productId])
  @@map("loans")
}

model LoanReturn {
  id           Int      @id @default(autoincrement())
  uid          String   @unique @default(cuid())
  loan         Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId       Int
  date         DateTime
  returnType   String   // GOODS | CASH | DEBT
  qty          Float
  pricePerUnit Float?
  note         String?
  txId         Int?
  createdAt    DateTime @default(now())

  @@map("loan_returns")
}

// ------------------------------ forex / dollar agents ------------------------------

model DollarAgent {
  id    Int    @id @default(autoincrement())
  uid   String @unique @default(cuid())
  name  String
  phone String?
  note  String?

  txs DollarAgentTx[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DollarAgentTx {
  id           Int         @id @default(autoincrement())
  uid          String      @unique @default(cuid())
  date         DateTime
  agent        DollarAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId      Int
  type         String      // EGP_IN | USD_OUT

  // EGP_IN: EGP given to agent
  egpAmount    Float       @default(0)
  treasury     TreasuryAccount? @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  treasuryId   Int?

  // USD_OUT: agent delivers USD to client
  usdAmount    Float       @default(0)
  exchangeRate Float       @default(0)
  party        Party?      @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyId      Int?

  note String?

  // id of the paired Transaction created alongside this agent tx, if any
  // (raw pointer, same convention as LoanReturn.txId) — see transaction-cascade.ts.
  txId Int?

  createdAt DateTime @default(now())

  @@index([agentId])
}


// ------------------------- تصفية الشركاء -------------------------

// طريقة التصفية — تُختار لكل شريك من الإعدادات.
enum ShareBasis {
  // برأس المال: نسبته = رأس ماله ÷ رأس مال الأصناف × 100 (بحد أقصى 100%)،
  // ونصيبه = صافي ربح الفواتير المختارة × نسبته.
  CAPITAL
  // تصفية ثابتة: مبلغ بالجنيه لكل وحدة. لكل فاتورة شراء مختارة،
  // المستحق = الكمية × المبلغ المكتوب لها (ليس نسبة مئوية).
  FIXED
}

// الشريك: اسم وطريقة تصفية. التصفية تمشي على الفواتير المختارة له، وكشف
// الحساب يجمع مستحقه منها.
//
// برأس المال: تُختار فواتير بيع كاملة، والحساب على أصناف المورد المحدد بسعر
// شرائها من قوائم أسعاره وسعر بيعها من الفاتورة، ناقص مصروف التشغيل.
// تصفية ثابتة: تُختار فواتير شراء، ويُكتب لكل فاتورة المبلغ للوحدة.
//
// الشريك المرتبط بحساب (userId) يرى تصفيته هو فقط.

model Partner {
  id            Int        @id @default(autoincrement())
  uid           String     @unique @default(cuid())
  name          String     @unique

  shareBasis    ShareBasis @default(CAPITAL)
  // رأس المال الافتتاحي. رأس المال الحالي = هذا + مجموع حركات الإضافة والنقص
  // (شوف PartnerCapitalMovement)، فالتعديلات لها سجل بتاريخها.
  capital       Float      @default(0)
  // مصروف تشغيل لكل كرتونة يُخصم من ربح الفاتورة. 0 = بدون خصم. (برأس المال فقط)
  cartonExpense Float      @default(0)

  // حساب الدخول. عند ربطه يرى صاحبه هذه التصفية فقط دون غيرها.
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        Int?       @unique
  active        Boolean    @default(true)
  note          String?

  suppliers        PartnerSupplier[]
  vehicles         PartnerVehicle[]
  capitalMovements PartnerCapitalMovement[]
  payments         PartnerPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// إضافة أو نقص رأس مال على القديم. مجموعها + الافتتاحي = رأس المال الحالي،
// والسجل يبيّن متى تغيّر وبكم.
model PartnerCapitalMovement {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(cuid())
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId Int
  date      DateTime
  // موجب = إضافة، سالب = نقص
  amount    Float
  note      String?

  createdBy   User? @relation("CapitalMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?

  createdAt DateTime @default(now())

  @@index([partnerId, date])
}

// دفعة اتسلّمها الاسم من مستحقه في التصفية. بتنزل في كشف حسابه فبيبان
// المتبقي عليه. دي حركة في كشف التصفية بس — مش حركة خزنة ولا سطر Transaction.
model PartnerPayment {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(cuid())
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId Int
  date      DateTime
  amount    Float
  note      String?

  createdBy   User? @relation("PartnerPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?

  createdAt DateTime @default(now())

  @@index([partnerId, date])
}

// الموردين اللي أصنافهم بتتحسب للاسم ده. مفيش أي صف = كل أصناف الفاتورة.
model PartnerSupplier {
  partner    Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId  Int
  supplier   Party   @relation("PartnerSupplier", fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId Int

  @@id([partnerId, supplierId])
  @@index([supplierId])
}

// قايمة أسعار المورد لفترة (من تاريخ لتاريخ). القوايم القديمة بتفضل محفوظة للأبد
// — الحسابات القديمة بتقرا منها، فمفيش حذف من الـ API خالص. الفترات مابتتعارضش
// لنفس المورد (الخدمة بتتحقق)، فكل تاريخ فاتورة بيوقع في قايمة واحدة بالكتير.
// التاريخين دايمًا منتصف ليل UTC، والنهاية داخلة في الفترة (inclusive).
model SupplierPriceList {
  id         Int      @id @default(autoincrement())
  uid        String   @unique @default(cuid())
  supplier   Party    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId Int
  weekStart  DateTime
  weekEnd    DateTime
  note       String?

  items     SupplierPriceListItem[]
  itemWeeks InvoiceItemWeek[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // أسبوع واحد لكل مورد = قايمة واحدة
  @@unique([supplierId, weekStart])
}

model SupplierPriceListItem {
  id          Int               @id @default(autoincrement())
  uid         String            @unique @default(cuid())
  priceList   SupplierPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceListId Int
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId   Int
  // سعر شراء الكرتونة من المورد في الأسبوع ده، بالجنيه
  price       Float             @default(0)

  @@unique([priceListId, productId])
  @@index([productId])
}

// فاتورة مختارة للتصفية. المدير هو من يختار.
//   برأس المال   → فاتورة بيع كاملة، والنصيب نسبة من صافي ربحها
//   تصفية ثابتة  → فاتورة شراء، والمستحق = الكمية × `rate`
model PartnerVehicle {
  id        Int     @id @default(autoincrement())
  uid       String  @unique @default(cuid())
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId Int
  // تصفية ثابتة: المبلغ بالجنيه لكل وحدة في هذه الفاتورة. يُكتب مع الاختيار
  // فيبقى ثابتاً عليها، فتغييره لاحقاً لا يُعيد تسعير فواتير سابقة.
  rate      Float?
  // برأس المال: تعديل يدوي لعدد الكراتين — بدونه العدد = مجموع كميات الأصناف
  cartons   Float?
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([partnerId, invoiceId])
  @@index([invoiceId])
}

// أسبوع مفروض على صنف في فاتورة — لما دفع العربية يتقسم على أسبوعين.
//
// المفتاح (الفاتورة، الصنف) مش سطر الفاتورة بالقصد: تعديل أي فاتورة بيمسح أسطرها
// ويعمل أسطر جديدة (invoices.repository: items deleteMany + create)، فلو الربط
// كان على invoiceItemId كان الأسبوع المفروض بيضيع بالصمت مع أي تعديل.
model InvoiceItemWeek {
  id          Int               @id @default(autoincrement())
  uid         String            @unique @default(cuid())
  invoice     Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   Int
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   Int
  priceList   SupplierPriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceListId Int

  createdAt DateTime @default(now())

  @@unique([invoiceId, productId])
  @@index([priceListId])
}
